{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm db:generate && pnpm db:migrate:deploy && pnpm --filter api build",
  "outputDirectory": ".next",
  "regions": ["fra1"],
  "crons": [
    { "path": "/api/cron/culinary-memory", "schedule": "0 5 * * *" },
    {
      "path": "/api/cron/recalc-criticality",
      "schedule": "0 4 * * 1"
    }
  ]
}
