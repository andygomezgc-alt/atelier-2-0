{
  "expo": {
    "name": "Atelier",
    "slug": "atelier",
    "scheme": "atelier",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.atelierchef.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.atelier.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#173C39"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Atelier accede a tu galería para que cambies tu foto de perfil.",
          "cameraPermission": "Atelier usa la cámara para que le saques una foto a tu receta y la organice."
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#f9f7f2"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.147262114833-pcalma01h1d16rrbe3o8iigk4lv0ubf2"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Atelier usa el micrófono para que dictes tus ideas al asistente.",
          "speechRecognitionPermission": "Atelier convierte tu voz en texto para el asistente.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "@sentry/react-native",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "813bc6e8-bac0-4377-ba73-26825523db2e"
      }
    },
    "owner": "andygome"
  }
}
