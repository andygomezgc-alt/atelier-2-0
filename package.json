{
  "name": "atelier",
  "private": true,
  "version": "0.0.0",
  "description": "Atelier Culinaire — cuaderno creativo del chef con asistente IA",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:mobile:tunnel": "pnpm --filter mobile exec expo start --tunnel",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @atelier/db exec prisma generate",
    "db:migrate": "pnpm --filter @atelier/db exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @atelier/db exec prisma migrate deploy",
    "db:seed": "pnpm --filter @atelier/db db:seed",
    "db:studio": "pnpm --filter @atelier/db exec prisma studio",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "test:backup": "node scripts/check-db-backup.mjs",
    "backup:production": "node scripts/backup-production.mjs",
    "backup:unpack": "node scripts/backup-unpack.mjs",
    "test:backup-encryption": "node --test scripts/check-backup-encryption.test.mjs",
    "test:backup-sync": "node --test scripts/check-backup-sync.test.mjs",
    "backup:daily": "node scripts/backup-daily.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "undici@6": "^6.27.0",
      "fast-uri@3": "^3.1.6",
      "sharp@0": "^0.35.4",
      "shell-quote@1": ">=1.9.0",
      "ws@8": "^8.21.0",
      "ws@7": "^7.5.11",
      "js-yaml@4": "^4.3.0",
      "@xmldom/xmldom@0.8": "^0.8.15",
      "@xmldom/xmldom@0.9": "^0.9.12",
      "brace-expansion@5": "^5.0.9",
      "browserslist@4": "^4.28.7",
      "ip-address@10": "^10.3.1",
      "nanoid@3": "^3.3.18"
    }
  }
}
