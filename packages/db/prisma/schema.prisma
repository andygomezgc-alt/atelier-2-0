generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  chef_executive
  sous_chef
  viewer
}

enum RecipeState {
  draft
  in_test
  approved
}

enum MenuStyle {
  elegant
  rustic
  minimal
  // "Tu estilo" — 4ª plantilla extraída por IA de la foto de la carta real.
  // Los tokens viven en Restaurant.menuStyleSpec (estilo DE LA CASA).
  custom
}

enum IdeaStatus {
  open
  in_chat
  archived
}

// ─────────── Banco de Productos ───────────

enum ProductCategory {
  pescado
  carne
  verdura
  fruta
  lacteo
  panaderia
  seco
  especia
  hierba
  vinagre_aceite
  otro
}

enum ProductUnit {
  kg
  g
  l
  ml
  unidad
  caja
}

enum ProductState {
  activo
  borrador
  archivado
}

// Cómo se determinó la merma de un producto:
//  - sugerida: cargada por defecto al crear (tabla de defaults o LLM)
//  - confirmada: editada/validada manualmente por el chef
//  - medida:    derivada de una prueba de rendimiento (YieldTest); prioritaria
enum MermaOrigin {
  sugerida
  confirmada
  medida
}

enum Criticality {
  alta
  media
  baja
}

// Entrega A.5 — Pezzatura estructurada.
// Distinguimos dos modos según la categoría del producto:
//  - pz_per_kg:   piezas por kilo (marisco/crostacei). Min/Max en pz/kg.
//  - g_per_piece: gramos por pieza (pescado entero, carne en pieza, fruta,
//                 panadería). Min/Max siempre en gramos.
// Render canónico se hace en cliente desde estos campos + categoría.
enum PezzaturaMode {
  pz_per_kg
  g_per_piece
}

// 14 alérgenos obligatorios — Reg. EU 1169/2011 Anexo II. Orden por número
// oficial del regulamento; el helper `ALLERGEN_ORDER` en @atelier/shared
// espeja este orden para presentar leyendas y listas de forma estable.
enum Allergen {
  gluten        // 1
  crustaceans   // 2
  eggs          // 3
  fish          // 4
  peanuts       // 5
  soy           // 6
  milk          // 7
  tree_nuts     // 8
  celery        // 9
  mustard       // 10
  sesame        // 11
  sulphites     // 12
  lupin         // 13
  molluscs      // 14
}

// Suscripción / planes. Los defaults (pilot/active) están elegidos a propósito:
// los restaurantes EXISTENTES (el piloto "Kokoo") arrancan pilot/active y NUNCA
// se bloquean. El candado (ENTITLEMENTS_ENFORCED) solo mira planStatus.
enum PlanTier {
  pilot
  founder
  early
  pro
}

enum PlanStatus {
  trial
  active
  past_due
  canceled
}

model Restaurant {
  id              String   @id @default(cuid())
  name            String
  identityLine    String?
  photoUrl        String?
  languageDefault String   @default("es")
  inviteCode      String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ─────────── "Tu estilo" (plantilla custom del PDF de menús) ───────────
  // Tokens de estilo extraídos por IA de una foto de la carta real (shape
  // MenuStyleSpecSchema en @atelier/shared). Es DE LA CASA: un solo estilo
  // por restaurante, cualquier menú con presentationStyle=custom lo usa.
  menuStyleSpec   Json?
  // Foto de referencia subida a Blob (best-effort; puede quedar null).
  menuStyleRefUrl String?

  // ─────────── Suscripción (Stripe) ───────────
  plan                 PlanTier   @default(pilot)
  planStatus           PlanStatus @default(active)
  trialEndsAt          DateTime?
  graceUntil           DateTime?
  stripeCustomerId     String?    @unique
  stripeSubscriptionId String?

  users         User[]
  ideas         Idea[]
  conversations Conversation[]
  recipes       Recipe[]
  menuFolders   MenuFolder[]
  auditLogs     AuditLog[]
  products      Product[]
  yieldTests    YieldTest[]
}

// Idempotencia del webhook de Stripe (P2-6, auditoría jul 2026). Un evento
// reentregado (Stripe reintenta si no respondemos 200 a tiempo, o llega fuera
// de orden) no debe reprocesarse — podría pisar planStatus con un estado
// viejo. `id` = event.id de Stripe; el segundo insert del mismo evento choca
// con la unique del @id y el handler lo trata como "ya visto".
model ProcessedStripeEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  photoUrl     String?
  bio          String?
  role         Role    @default(viewer)
  languagePref String  @default("es")
  defaultModel String  @default("sonnet")
  tokenVersion Int     @default(0)

  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ideas           Idea[]
  conversations   Conversation[]
  recipes         Recipe[]         @relation("RecipeAuthor")
  approvedRecipes Recipe[]         @relation("RecipeApprovedBy")

  // Auth.js (NextAuth) relations — populated by the @auth/prisma-adapter
  accounts Account[]
  sessions Session[]

  auditLogs AuditLog[] @relation("AuditLogActor")

  yieldTests           YieldTest[]           @relation("YieldTestAuthor")
  productPriceHistory  ProductPriceHistory[] @relation("PriceHistoryAuthor")

  aiUsage AiUsage[]

  @@index([restaurantId])
}

model Idea {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  text         String     @db.Text
  status       IdeaStatus @default(open)
  createdAt    DateTime   @default(now())

  conversation Conversation?

  @@index([restaurantId, createdAt])
}

model Conversation {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  ideaId       String?    @unique
  idea         Idea?      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  modelUsed    String
  createdAt    DateTime   @default(now())

  messages Message[]
  recipes  Recipe[]

  @@index([restaurantId, createdAt])
  @@index([authorId, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  inputTokens  Int?
  outputTokens Int?
  cachedTokens Int?
  latencyMs    Int?

  @@index([conversationId, createdAt])
}

/// Contador diario por usuario de llamadas a la IA hechas con la clave
/// ANTHROPIC del server. Protege contra que una sola cuenta agote la
/// clave compartida. Una fila por (userId, día-UTC). Ver lib/ai-quota.ts.
model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day          String // YYYY-MM-DD en UTC
  requestCount Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, day])
  @@index([day])
}

model Recipe {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation("RecipeAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  title       String
  version     Int    @default(1)
  contentJson Json

  // Banco de Productos — campos cost/yield. Opcionales; las recetas legacy
  // sin productos enlazados muestran costo total cuando los ingredients pasen
  // por la migración de Fase 5. portions default 1 para no romper UIs viejas.
  portions  Int?
  salePrice Int? // centavos

  state    RecipeState @default(draft)
  priority Boolean     @default(false)

  // Alérgenos añadidos manualmente desde el "+" en la preview del menú.
  // Aditivos globales (cualquier menú que use la receta los hereda). Los
  // alérgenos heredados de productos NO viven acá: se computan al vuelo
  // por `computeRecipeAllergens` uniéndolos con esta lista. "Quitar" desde
  // el sheet solo elimina entradas de esta columna, nunca toca los heredados.
  manualAllergens Allergen[] @default([])

  sourceConversationId String?
  sourceConversation   Conversation? @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)

  approvedById String?
  approvedBy   User?     @relation("RecipeApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItems         MenuItem[]
  recipeIngredients RecipeIngredient[]

  @@index([restaurantId, state])
  @@index([restaurantId, priority])
  @@index([restaurantId, title])
  @@index([restaurantId, deletedAt])
}

model MenuFolder {
  id                String     @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name              String
  season            String?
  presentationStyle MenuStyle  @default(elegant)
  // Bloque 5 — estado "en servicio" independiente por menú. Varios pueden
  // estar prendidos a la vez (carta fija + degustación + …). Default false:
  // los menús existentes arrancan apagados. El chef los enciende manualmente.
  inService         Boolean    @default(false)
  // Toggle global del menú. ON = TODOS los alérgenos del plato salen en
  // el PDF cliente (sin granularidad por alérgeno). OFF = ninguno. La
  // preview chef siempre los muestra completos; este flag solo afecta
  // al render del PDF cliente (apps/api/lib/pdf).
  showAllergensInPdf Boolean   @default(true)
  // Papelera: borrado suave. null = activo; fecha = en la papelera (restaurable).
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  items          MenuItem[]
  sections       MenuSection[]
  clientOverride MenuClientOverride?

  @@index([restaurantId])
  @@index([restaurantId, updatedAt])
  @@index([restaurantId, inService])
  @@index([restaurantId, deletedAt])
}

// Capa de overrides "solo para PDF cliente" — el compositor (staff) jamás
// los muestra. JSON con nombres editables de restaurante, menú, subtítulo,
// secciones e items. Si un campo está ausente, el PDF cliente usa el valor
// canónico del MenuItem / MenuFolder / Restaurant.
model MenuClientOverride {
  id           String     @id @default(cuid())
  menuFolderId String     @unique
  menuFolder   MenuFolder @relation(fields: [menuFolderId], references: [id], onDelete: Cascade)
  overrides    Json       @default("{}")
  updatedAt    DateTime   @updatedAt
}

model MenuSection {
  id           String     @id @default(cuid())
  menuFolderId String
  menuFolder   MenuFolder @relation(fields: [menuFolderId], references: [id], onDelete: Cascade)
  name         String
  order        Int
  createdAt    DateTime   @default(now())

  items MenuItem[]

  @@index([menuFolderId, order])
}

model MenuItem {
  id           String       @id @default(cuid())
  menuFolderId String
  menuFolder   MenuFolder   @relation(fields: [menuFolderId], references: [id], onDelete: Cascade)
  sectionId    String?
  section      MenuSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  recipeId     String
  recipe       Recipe       @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  customName   String?
  customDesc   String?      @db.Text
  price        Int
  order        Int

  @@index([menuFolderId, order])
  @@index([sectionId, order])
  // "En qué menús está esta receta" (recipeDetailInclude) hace reverse-lookup
  // por recipeId en cada detalle de receta — sin este índice era scan de tabla.
  @@index([recipeId])
}

// ─────────── Auth.js (NextAuth) tables ───────────
// Required by @auth/prisma-adapter. We intentionally keep them in the same
// schema so a single migration owns the whole DB.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  actorId      String?
  actor        User?      @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action       String     // e.g. "staff_role_changed", "staff_removed", "invite_regenerated"
  targetType   String?    // e.g. "User"
  targetId     String?
  payload      Json?
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
  @@index([actorId, createdAt])
}

// ─────────── Banco de Productos ───────────

// Anagrafica de productos del restaurante. Cada producto se cobra una vez,
// se actualiza su precio y merma, y aparece enlazado en las recetas.
//
// Costo real = precioCompra / (1 - mermaPct/100) — calculado en read time,
// NUNCA persistido para evitar inconsistencias si alguien actualiza el
// precio o la merma sin recalcular.
model Product {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name      String
  category  ProductCategory
  // Legacy: texto libre del calibre (ej. "15/20", "2-4 kg"). Se mantiene como
  // notas humanas durante la transición; el cálculo de costeo usa los campos
  // estructurados pezzaturaMode/Min/Max. Migración retroactiva en Fase 3.
  pezzatura String?

  // Entrega A.5 — pezzatura estructurada. Los tres campos van juntos:
  // todos null (sin pezzatura cargada) o todos no-null (válida). Enforced
  // por CHECK Product_pezzatura_consistency.
  pezzaturaMode PezzaturaMode?
  pezzaturaMin  Decimal?       @db.Decimal(10, 2)
  pezzaturaMax  Decimal?       @db.Decimal(10, 2)

  unidadCompra ProductUnit
  precioCompra Int // centavos / cents

  mermaPct    Decimal     @default(0) @db.Decimal(5, 2)
  mermaOrigen MermaOrigin @default(sugerida)

  proveedor           String?
  precioActualizadoAt DateTime @default(now())
  notas               String?  @db.Text
  estado              ProductState @default(activo)

  // Aliases para matching: nombres alternativos que apuntan al mismo producto.
  // Ej. "trufa negra" puede tener aliases ["trufa", "tartufo nero", "truffe"].
  aliases String[] @default([])

  // criticality es auto-asignada por categoría + excepciones; criticalityManual
  // = true cuando el chef la sobrescribió y no querés que el job semanal la pise.
  criticality       Criticality
  criticalityManual Boolean     @default(false)

  // Reg. EU 1169/2011 — 0 o 1 alérgeno por producto (uno solo o ninguno;
  // ej. aceite de oliva = null). El plato calcula sus alérgenos uniendo
  // este campo de cada ingrediente enlazado + Recipe.manualAllergens.
  allergen Allergen?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  recipeIngredients RecipeIngredient[]
  yieldTests        YieldTest[]
  priceHistory      ProductPriceHistory[]

  @@index([restaurantId, estado])
  @@index([restaurantId, criticality])
  @@index([restaurantId, deletedAt])
  @@index([restaurantId, name])
}

// Línea de ingrediente dentro de una receta. rawText siempre se preserva
// (audit trail del texto original que entró por chef, asistente o upload).
// productId opcional para casos donde todavía no se enlazó al banco (legacy
// o match dudoso aún sin confirmar).
model RecipeIngredient {
  id        String   @id @default(cuid())
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  position  Int

  rawText          String   @db.Text
  qty              Decimal? @db.Decimal(10, 3)
  unit             String?
  pezzatura        String?
  // Permite que una receta use una merma distinta a la default del producto
  // (ej. "este corte va con merma especial"). Null = usar la del Product.
  mermaOverridePct Decimal? @db.Decimal(5, 2)

  // Entrega A.5 — override de "peso por pieza" para esta receta puntual.
  // Solo aplica cuando unit = "piezas" y el chef quiere usar un peso distinto
  // al rango del banco (ej. "yo compro gambero más grande para este plato").
  // Null = usar el punto medio de pezzaturaMin/Max del producto. Enforced
  // > 0 por CHECK RecipeIngredient_pesoCalculoG_positive.
  pesoCalculoG     Decimal? @db.Decimal(10, 3)

  @@index([recipeId, position])
  @@index([productId])
}

// Prueba de rendimiento. El chef carga peso bruto + peso útil y el sistema
// calcula la merma. Histórico para ver evolución (ej. una variedad de pescado
// rinde distinto en distintas estaciones).
model YieldTest {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation("YieldTestAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  pesoBrutoG        Decimal @db.Decimal(10, 3)
  pesoUtilG         Decimal @db.Decimal(10, 3)
  mermaCalculadaPct Decimal @db.Decimal(5, 2)
  notas             String? @db.Text

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

// Cada vez que el precio de un producto cambia se inserta una fila acá.
// La fuente de verdad del precio "actual" sigue siendo Product.precioCompra
// — esto es historial para ver evolución temporal.
model ProductPriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("PriceHistoryAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  precio       Int // centavos
  unidadCompra ProductUnit

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}
