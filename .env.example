# Postgres (Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/atelier_dev?sslmode=require

# Auth.js — NextAuth v5 lee AUTH_SECRET como canonico pero acepta NEXTAUTH_SECRET
# legacy; los DOS deben existir con el MISMO valor.
# Generar en Windows (sin openssl): PowerShell con RandomNumberGenerator.Fill()
# sobre 32 bytes y base64 (NUNCA Get-Random, no es criptograficamente seguro).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-32-bytes-base64
AUTH_SECRET=replace-with-32-bytes-base64

# Sign in with Apple (SOLO servidor; nunca usar prefijo EXPO_PUBLIC_)
# El Client ID de la app iOS nativa es su Bundle ID.
APPLE_CLIENT_ID=com.atelierchef.app
APPLE_TEAM_ID=TU6284T7J8
# ID de una clave dedicada a Sign in with Apple creada en Apple Developer.
# La API key de App Store Connect usada para subir builds no necesariamente sirve.
APPLE_KEY_ID=replace-with-sign-in-with-apple-key-id
# Contenido completo del archivo .p8. En proveedores que no admiten saltos de
# linea, guardar los saltos como \n; la app del servidor los normaliza al leerla.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Clave independiente y aleatoria de 32 bytes (base64) para cifrar los tokens de
# Apple guardados en la base de datos. No reutilizar AUTH_SECRET.
APPLE_TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Resend (magic link)
RESEND_API_KEY=re_xxx
RESEND_FROM=Atelier <noreply@example.com>
# Opcional: las respuestas de los chefs al correo del magic link van aca
RESEND_REPLY_TO=tu-email@example.com

# IA — solo servidor. Nunca usar EXPO_PUBLIC_ para estas claves.
# Chat Creativo (Opus), Chat Diario (Gemini), resto de funciones (GLM).
ANTHROPIC_API_KEY=sk-ant-xxx
GEMINI_API_KEY=
ZAI_API_KEY=

# Versiones fijadas; actualizar aquí/en el entorno del servidor tras verificarlas.
# Cambiar un modelo no requiere recompilar el APK si conserva el mismo protocolo.
AI_CHAT_CREATIVE_MODEL=claude-opus-5
AI_CHAT_DAILY_MODEL=gemini-3.8-flash
AI_GLM_MODEL=glm-5.3-flash
# Opcionales: sobreescriben AI_GLM_MODEL para una tarea concreta.
AI_EXTRACTION_MODEL=
AI_MENU_STYLE_MODEL=
AI_MENU_THEME_MODEL=
CULINARY_MEMORY_MODEL=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ─── Stripe (billing / plan Pro) ───
# Clave secreta de la API de Stripe. Sin ella se usa el placeholder
# "sk_test_placeholder" y el portal de cliente / checkout real NO funciona.
STRIPE_SECRET_KEY=sk_test_xxx
# Secreto de firma del webhook. Sin él, POST /api/stripe/webhook responde 503
# (no configurado). Sin default.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Contratación cerrada durante el piloto. /pro solo permite solicitar acceso.
# No usar los antiguos STRIPE_PAYMENT_LINK_PRO / STRIPE_PAYMENT_LINK_FOUNDER.
# Preparar primero en un entorno Stripe de PRUEBA; no activar en producción.
BILLING_CHECKOUT_ENABLED=0
# Origen fijo de retorno, sin ruta, query ni credenciales.
BILLING_SITE_URL=https://atelier-2-0-mu.vercel.app
# Precio recurrente Pro: 49 EUR/mes, quantity 1, tax_behavior=exclusive.
STRIPE_PRICE_PRO=
# Cupón 50%, repeating, duration_in_months=3. Nunca un precio perpetuo de 24,50.
STRIPE_COUPON_FOUNDER=
# Elegibilidad administrada en servidor; vacía = ningún restaurante fundador.
BILLING_FOUNDER_RESTAURANT_IDS=
# Portal con cancelación al final del período y sin cambios de precio/plan.
STRIPE_PORTAL_CONFIGURATION=

# ─── Operativas ───
# Candado de plan (entitlements). Solo el valor EXACTO "1" aplica los límites de
# plan; cualquier otro valor o ausente = candado APAGADO (default: off).
ENTITLEMENTS_ENFORCED=0
# Secreto del cron de recálculo (Vercel Cron) y de GET /api/debug-sentry. Se
# envía como header `Authorization: Bearer <CRON_SECRET>`. Sin él esas rutas
# responden 401/404. Sin default.
CRON_SECRET=replace-with-random-secret

# Mobile (apps/mobile/.env.local, prefijo EXPO_PUBLIC_ = legible en el bundle JS)
EXPO_PUBLIC_API_URL=http://localhost:3000
